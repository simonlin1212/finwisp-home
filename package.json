{
  "name": "finwisp-home",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "mcp": "tsx mcp-server/index.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "demo": "tsx scripts/demo.ts",
    "live-check": "tsx scripts/live-check.ts",
    "live-bank-check": "tsx scripts/live-bank-check.ts",
    "hub": "npm run web:build && tsx host/index.ts",
    "web:build": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts web",
    "web:preview": "vite preview --config web/vite.config.ts --host 127.0.0.1 --port 4173 web",
    "typecheck": "tsc",
    "hub:check": "npm run web:build && tsx scripts/hub-check.ts",
    "worker:build": "node scripts/build-worker.mjs",
    "remote-check": "tsx scripts/remote-check.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.4"
  },
  "imports": {
    "#file-storage": {
      "workerd": "./worker/file-storage.ts",
      "default": "./mcp-server/file-storage.ts"
    }
  }
}
