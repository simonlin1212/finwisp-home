{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "mcp-server/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "orchestrator/**/*.ts",
    "host/**/*.ts"
  ]
}
